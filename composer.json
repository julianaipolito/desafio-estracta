{
    "name": "julianaipolito/desafio-estracta",
    "description": "Desafio estracta: spider da consulta pública por CNPJ ao cadastro de contribuintes da SEFAZ-BA.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "pestphp/pest": "^2.36"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "ProvaSpider\\": "src/"
        }
    },
    "scripts": {
        "test": "pest",
        "consultar": "@php bin/consultar.php"
    }
}
